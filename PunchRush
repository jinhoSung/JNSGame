   if(index===0){ctx.save();ctx.strokeStyle=colors[e.lane];ctx.lineWidth=3;ctx.shadowColor=colors[e.lane];ctx.shadowBlur=9;ctx.beginPath();ctx.ellipse(x,foot+3,height*.25,height*.055,0,0,Math.PI*2);ctx.stroke();ctx.restore()}
   sprite(enemyName(lane),x,foot,height,{alpha:[1,.82,.60][index]});
  }
 }
 // Defeated enemies leave the lane with spin and knockback.
 for(const f of flying){const t=1-f.life/f.max;sprite(enemyName(f.lane),f.x+f.vx*t,f.y-f.vy*t,frontHeight()*(1-t*.55),{angle:f.spin*t,alpha:Math.max(0,1-t)})}
 if(failEnemy&&(state==='failing'||state==='over')){
  const t=Math.min(1,failTime/.22);const list=failEnemy.lane===1?[0,2]:[failEnemy.lane];
  for(const lane of list){
   const windup=failTime>.22&&failTime<.30;
   const punch=failTime>=.30&&failTime<.56;
   sprite(enemyName(lane)+(punch?'-punch':''),laneX(lane)+(w/2-laneX(lane))*t*.58,h*(.74+.10*t),frontHeight()*(1-.12*t),{angle:windup?(lane===0?-.10:.10):punch?(lane===0?.12:-.12):0,flip:punch&&lane===2});
  }
 }
 const attacking=attack>0,pulse=attacking?Math.sin(Math.PI*(1-attack/.20)):0;
 const heroHeight=Math.min(h*.29,w*.40),heroX=w/2+(attackLane===0?-1:attackLane===2?1:0)*pulse*w*.09,heroY=h*.94-pulse*h*.065;
 shadow(w/2,h*.95,heroHeight*.23);
 let heroAngle=attacking?(attackLane===0?-.18:attackLane===2?.18:0)*pulse:0;
 const defeated=(state==='failing'||state==='over')&&failTime>=.30;
 const image=heroName()+(attacking?'-punch':'');
 if(attacking&&fever>0){for(let i=3;i>0;i--)sprite(image,heroX-(heroX-w/2)*i*.4,heroY+i*5,heroHeight,{flip:attackLane===0,alpha:.08+i*.04,angle:heroAngle,glow:'#ffcf45'})}
 if(defeated){
  const t=Math.min(1,(failTime-.30)/.40),push=failEnemy?.lane===0?1:failEnemy?.lane===2?-1:1;
  const centerY=h*.94-heroHeight*.5+(h*.88-(h*.94-heroHeight*.5))*t-Math.sin(t*Math.PI)*h*.09;
  const bounce=failTime>=.70&&failTime<.82?-Math.sin((failTime-.70)/.12*Math.PI)*6:0;
  sprite(heroName()+'-ko',w/2+push*w*.045*t,centerY+bounce,heroHeight,{center:true,angle:push*t*1.48});
  if(deathLanded){ctx.save();ctx.fillStyle='#ffdf69';for(let i=0;i<3;i++){const a=i*Math.PI*2/3+failTime*6,x=w/2+Math.cos(a)*25,y=h*.77+Math.sin(a)*6;ctx.font='bold 15px Arial';ctx.fillText('★',x,y)}ctx.restore()}
 }else sprite(image,heroX,heroY,heroHeight*(1+pulse*.1),{flip:attacking&&attackLane===0,angle:heroAngle,glow:fever>0?'#ffcf45':null});
 if(saved.pet>0){const petY=h*.96-Math.abs(Math.sin(world*5))*4-pulse*10;shadow(w*.80,h*.965,18);sprite(pets[saved.pet].asset,w*.80,petY,Math.min(h*.13,72),{angle:pulse*.15})}
 // Short directional streaks lead from the fighter toward the hit.
 for(const fx of hitEffects){
  const t=1-fx.life/fx.max,scale=(.75+Math.sin(t*Math.PI)*.50)*(fx.strong?1.45:1),sz=frontHeight()*.76*scale;
  ctx.save();ctx.globalAlpha=Math.max(0,(1-t)*.75);ctx.strokeStyle=fx.strong?'#fff0a5':'#fff';ctx.lineWidth=fx.strong?8:4;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(w/2,h*.85);ctx.lineTo(fx.x,fx.y);ctx.stroke();ctx.restore();
  if(t<.76)sprite('impact',fx.x,fx.y+sz*.5,sz,{angle:fx.spin,alpha:Math.max(0,1-t/.76),glow:fx.strong?'#ffb829':null});
  ctx.save();ctx.strokeStyle=fx.strong?'#ffe785':'#fff4d0';ctx.globalAlpha=(1-t)*.8;ctx.lineWidth=3;ctx.beginPath();ctx.arc(fx.x,fx.y,12+t*sz*.6,0,Math.PI*2);ctx.stroke();ctx.restore();
 }
 for(const p of particles){ctx.globalAlpha=p.life/p.max;ctx.fillStyle=p.color;ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.life*8);ctx.fillRect(-2,-2,p.size||5,p.size||5);ctx.restore()}ctx.globalAlpha=1;
 if(flash>0){ctx.fillStyle='rgba(255,226,152,'+Math.min(.22,flash*1.5)+')';ctx.fillRect(0,0,w,h)}
 if(comboBanner>0){ctx.save();ctx.translate(w/2,h*.16);const scale=1+Math.max(0,comboBanner-.7)*.35;ctx.scale(scale,scale);ctx.font='italic 900 28px Arial';ctx.strokeStyle='#2b1b19';ctx.lineWidth=5;ctx.strokeText(combo+' COMBO!',0,0);ctx.fillStyle='#ffda59';ctx.fillText(combo+' COMBO!',0,0);ctx.restore()}
 if(fever>0){ctx.font='italic 900 22px Arial';ctx.strokeStyle='#382311';ctx.lineWidth=4;ctx.strokeText('FEVER RUSH ×2',w/2,34);ctx.fillStyle='#ffe175';ctx.fillText('FEVER RUSH ×2',w/2,34)}
 ctx.restore();
}

function frame(now){if(!last)last=now;acc+=Math.min(.1,(now-last)/1000);last=now;while(acc>=1/120){step(1/120);acc-=1/120}draw();requestAnimationFrame(frame)}
document.querySelectorAll('[data-lane]').forEach(b=>b.addEventListener('pointerdown',e=>{e.preventDefault();if(state==='over'){start();return}input(Number(b.dataset.lane));b.classList.add('pressed');setTimeout(()=>b.classList.remove('pressed'),75)}));
document.addEventListener('pointerdown',e=>{if(e.target.closest('#hub,.loadout,#sound'))return;if(state==='ready'&&e.target.closest('#start')){e.preventDefault();start()}});
document.addEventListener('click',e=>{if(e.target.closest('#start')&&(state==='ready'||state==='over'))start()});
document.addEventListener('keydown',e=>{if(e.target.closest?.('#hub,input,textarea'))return;const map={a:0,s:1,d:2,ArrowLeft:0,ArrowDown:1,ArrowRight:2};if(e.repeat)return;if(e.code==='Space'&&(state==='ready'||state==='over')){e.preventDefault();start();return}if(map[e.key]!==undefined){e.preventDefault();if(state==='over')start();else input(map[e.key])}});
$('#sound').addEventListener('pointerdown',e=>{e.stopPropagation();muted=!muted;$('#sound').textContent=muted?'SOUND OFF':'SOUND ON'});
document.addEventListener('visibilitychange',()=>{last=0;acc=0});
resize();updateUI();loadout();requestAnimationFrame(frame);
// A small test interface exercises the same queue and fixed-step simulation as live play.
window.PunchRush={start,input,step,snapshot:()=>({state,score,combo,energy,remaining:energy/((12+Math.min(combo*.12,14))*(runStats?.drain||1)),queue:queue.map(q=>q.lane),enemies:enemies.map(e=>({...e})),fever,attack,failTime,failPause,deathHit,deathLanded,soundEvents:[...soundHistory],hitEffects:hitEffects.length,flying:flying.length,character:saved.character,pet:saved.pet,item:saved.item,coins:saved.coins,owned:JSON.parse(JSON.stringify(saved.owned)),name:saved.name,runStats:runStats?{...runStats}:null,assetsLoaded:Object.values(art).filter(i=>i.complete&&i.naturalWidth).length}),setPattern(pattern){enemies=pattern.map((lane,i)=>({lane,y:.68-i*gap()}));while(enemies.length<8)enemies.push(nextEnemy(enemies.at(-1).y-gap()))}};

</script></body></html>

